{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "preload*.js",
    "main.js",
    "*.html",
    "ui-actions.js",
    "html-sanitizer.js",
    "app-init.js",
    "sections/**/*.js",
    "common.js",
    "navigation.js",
    "accounts.js",
    "instances.js",
    "modrinth.js",
    "launcher.js",
    "sections/**/*.html",
    "scripts/**/*.js"
  ],
  "project": [
    "**/*.js"
  ],
  "ignore": [
    "auditoria/**"
  ],
  "ignoreDependencies": [
    "@fortawesome/fontawesome-free",
    "app-builder-lib",
    "@electron/asar"
  ]
}
