---
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';
import { VERSION } from '../data/downloads';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  faq?: { question: string; answer: string }[];
}

const { title, description, noindex = false, faq = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const siteURL = Astro.site ?? 'https://kindyrlauncher.pages.dev';
// Cada página se publica como carpeta: canonical, hreflang y sitemap van con barra final.
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, siteURL);
const socialImage = new URL('/og-cover.png', siteURL);

const localizedPath = pathname.replace(/^\/[^/]+/, '');
const alternates = [
  ...['en', 'es', 'pt', 'ru'].map((code) => ({ hreflang: code, href: new URL(`/${code}${localizedPath}`, siteURL) })),
  { hreflang: 'x-default', href: new URL(`/en${localizedPath}`, siteURL) },
];

const localeMap: Record<string, string> = {
  en: 'en_US',
  es: 'es_UY',
  ru: 'ru_RU',
  pt: 'pt_BR',
};
const ogLocale = localeMap[lang] || 'es_UY';

const ogAlt: Record<string, string> = {
  es: 'Kindyr, el launcher de Minecraft para jugar a tu manera',
  en: 'Kindyr, the Minecraft launcher to play your way',
  pt: 'Kindyr, o launcher de Minecraft para jogar do seu jeito',
  ru: 'Kindyr — лаунчер Minecraft, чтобы играть по-своему',
};
const keywords: Record<string, string> = {
  es: 'Kindyr, launcher de Minecraft, Modrinth, modpacks, Forge, Fabric, NeoForge, Quilt, código abierto',
  en: 'Kindyr, Minecraft launcher, Modrinth, modpacks, Forge, Fabric, NeoForge, Quilt, open source',
  pt: 'Kindyr, launcher de Minecraft, Modrinth, modpacks, Forge, Fabric, NeoForge, Quilt, código aberto',
  ru: 'Kindyr, лаунчер Minecraft, Modrinth, модпаки, Forge, Fabric, NeoForge, Quilt, открытый исходный код',
};
const skipText: Record<string, string> = {
  es: 'Saltar al contenido',
  en: 'Skip to content',
  pt: 'Pular para o conteúdo',
  ru: 'Перейти к содержимому',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kindyr',
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Windows, Linux',
  isAccessibleForFree: true,
  softwareVersion: VERSION,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: canonicalURL.toString(),
  downloadUrl: 'https://github.com/iDontrixss/KindyrLauncher/releases',
  codeRepository: 'https://github.com/iDontrixss/KindyrLauncher',
  featureList: [
    'Gestión de instancias de Minecraft',
    'Integración con Modrinth',
    'Importación de paquetes .mrpack',
    'Compatibilidad con múltiples loaders',
    'Gestión de cuentas Microsoft',
  ],
  author: {
    '@type': 'Person',
    name: 'iDontrixss',
    url: 'https://github.com/iDontrixss',
  },
  inLanguage: lang,
};

const faqData = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: faq.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
} : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#061840" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords[lang] ?? keywords.es} />
    <meta name="author" content="iDontrixss" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="generator" content={Astro.generator} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {!noindex && alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="icon" type="image/png" href="/kindyr-favicon.png?v=3" sizes="500x500" />
    <link rel="apple-touch-icon" href="/kindyr-favicon.png?v=3" />
    <link rel="preload" href="/kindyr-logo.png" as="image" />
    {lang === 'ru' ? (
      <link rel="preload" href="/fonts/caveat/Caveat-Regular-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/fonts/neucha/Neucha-Regular-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/fonts/lobster/Lobster-Regular-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    ) : (
      <link rel="preload" href="/fonts/yuyu/Yuyu-Regular.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/fonts/indie-flower/IndieFlower-Regular.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/fonts/sue-ellen-francisco/SueEllenFrancisco-Regular.woff2" as="font" type="font/woff2" crossorigin />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Kindyr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt[lang] ?? ogAlt.es} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {faqData && <script type="application/ld+json" set:html={JSON.stringify(faqData)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{skipText[lang] ?? skipText.es}</a>
    <slot />
  </body>
</html>
