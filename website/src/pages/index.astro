---
import '../styles/global.css';
import { languages } from '../i18n/ui';

// Puerta de entrada: detecta el idioma del visitante y lo manda a su locale.
// Solo actúa en "/" (los enlaces /es/, /en/... se quedan donde están).
// Orden: 1) idioma del navegador, 2) zona horaria, 3) inglés por defecto
// (el más hablado en la comunidad de Minecraft y en el mundo).
// Sin JS: se muestra el selector y un meta-refresh lleva a /en/.
const site = Astro.site ?? 'https://kindyrlauncher.pages.dev';
// Nombre del sitio para Google: sin WebSite JSON-LD en la raíz, en *.pages.dev muestra "Cloudflare".
const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Kindyr Launcher',
  alternateName: ['Kindyr', 'KindyrLauncher'],
  url: new URL('/', site).toString(),
};
const localeLinks = [
  { code: 'en', href: '/en/' },
  { code: 'es', href: '/es/' },
  { code: 'ru', href: '/ru/' },
  { code: 'pt', href: '/pt/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#061840" />
    <meta name="google-site-verification" content="RIhyC6JVKtizIaV7jpvRVsIoApMM5TFLPzIAIbxcAcM" />
    <meta name="google-site-verification" content="e7IVkBIkszEpZTh0s3TMUhnwcZqXOji50KwhTASEn5Q" />
    <meta name="color-scheme" content="dark" />
    <title>Kindyr — Choose your language</title>
    <meta
      name="description"
      content="Choose your language: English, Español, Português, Русский."
    />
    <link rel="canonical" href={new URL('/en/', site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', site)} />
    <link rel="alternate" hreflang="ru" href={new URL('/ru/', site)} />
    <link rel="alternate" hreflang="pt" href={new URL('/pt/', site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', site)} />
    <link rel="icon" type="image/png" href="/kindyr-favicon.png?v=3" sizes="500x500" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteData)} />
    <meta http-equiv="refresh" content="4;url=/en/" />
  </head>
  <body>
    <div class="site-shell locale-gate">
      <main id="contenido" class="section-grid locale-gate__inner">
        <img src="/kindyr-logo.png" alt="Kindyr" width="72" height="72" />
        <h1>Kindyr</h1>
        <p data-locale-gate-note>Detecting your language…</p>
        <div class="locale-gate__grid">
          {localeLinks.map((option) => (
            <a class="button button-small locale-gate__btn" href={option.href} lang={option.code}>
              {languages[option.code as keyof typeof languages]}
            </a>
          ))}
        </div>
      </main>
    </div>

    <script is:inline>
      (() => {
        // Idioma primario del tag (es-UY -> es). Catalán, gallego y euskera
        // conviven con el español en España.
        const LANG_TO_LOCALE = {
          es: 'es', en: 'en', pt: 'pt', ru: 'ru', ca: 'es', gl: 'es', eu: 'es',
        };
        const localeFromLanguages = (list) => {
          for (const raw of list) {
            const primary = String(raw || '').toLowerCase().replace('_', '-').split('-')[0];
            if (LANG_TO_LOCALE[primary]) return LANG_TO_LOCALE[primary];
          }
          return null;
        };
        // Respaldo por zona horaria (tabla acotada: lo no listado cae a inglés).
        const TIMEZONE_TO_LOCALE = {
          // Español
          'Europe/Madrid': 'es', 'Atlantic/Canary': 'es', 'Africa/Ceuta': 'es', 'Africa/Melilla': 'es',
          'America/Mexico_City': 'es', 'America/Cancun': 'es', 'America/Monterrey': 'es', 'America/Tijuana': 'es',
          'America/Bogota': 'es', 'America/Lima': 'es', 'America/Santiago': 'es', 'America/Guayaquil': 'es',
          'America/Buenos_Aires': 'es', 'America/Cordoba': 'es', 'America/Mendoza': 'es', 'America/Montevideo': 'es',
          'America/Asuncion': 'es', 'America/Caracas': 'es', 'America/La_Paz': 'es',
          'America/Santo_Domingo': 'es', 'America/Havana': 'es', 'America/Puerto_Rico': 'es', 'America/Panama': 'es',
          'America/Costa_Rica': 'es', 'America/Guatemala': 'es', 'America/Tegucigalpa': 'es', 'America/Managua': 'es',
          'America/El_Salvador': 'es',
          // Portugués
          'Europe/Lisbon': 'pt', 'Atlantic/Madeira': 'pt', 'Atlantic/Azores': 'pt',
          'America/Sao_Paulo': 'pt', 'America/Bahia': 'pt', 'America/Belem': 'pt', 'America/Fortaleza': 'pt',
          'America/Recife': 'pt', 'America/Maceio': 'pt', 'America/Araguaina': 'pt', 'America/Campo_Grande': 'pt',
          'America/Cuiaba': 'pt', 'America/Santarem': 'pt', 'America/Porto_Velho': 'pt', 'America/Boa_Vista': 'pt',
          'America/Manaus': 'pt', 'America/Rio_Branco': 'pt', 'America/Noronha': 'pt',
          'Africa/Maputo': 'pt', 'Africa/Luanda': 'pt', 'Africa/Bissau': 'pt', 'Atlantic/Cape_Verde': 'pt',
          'Africa/Sao_Tome': 'pt', 'Asia/Macau': 'pt',
          // Ruso
          'Europe/Moscow': 'ru', 'Europe/Kaliningrad': 'ru', 'Europe/Simferopol': 'ru', 'Europe/Volgograd': 'ru',
          'Europe/Samara': 'ru', 'Asia/Yekaterinburg': 'ru', 'Asia/Omsk': 'ru', 'Asia/Novosibirsk': 'ru',
          'Asia/Krasnoyarsk': 'ru', 'Asia/Irkutsk': 'ru', 'Asia/Yakutsk': 'ru', 'Asia/Vladivostok': 'ru',
          'Asia/Magadan': 'ru', 'Asia/Kamchatka': 'ru', 'Asia/Anadyr': 'ru', 'Asia/Sakhalin': 'ru',
          'Europe/Minsk': 'ru',
        };
        const localeFromTimeZone = () => {
          try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (tz && TIMEZONE_TO_LOCALE[tz]) return TIMEZONE_TO_LOCALE[tz];
          } catch (e) {}
          return null;
        };
        const nav = Array.isArray(navigator.languages) && navigator.languages.length
          ? navigator.languages
          : [navigator.language];
        const locale = localeFromLanguages(nav.filter(Boolean)) || localeFromTimeZone() || 'en';
        window.location.replace('/' + locale + '/');
      })();
    </script>

    <style>
      .locale-gate { display: grid; min-height: 100vh; place-items: center; }
      .locale-gate__inner { display: grid; justify-items: center; gap: 18px; text-align: center; }
      .locale-gate__inner h1 { margin: 0; font-size: clamp(2.5rem, 6vw, 4rem); letter-spacing: -0.04em; text-transform: uppercase; }
      .locale-gate__inner p { margin: 0; color: var(--muted); font-size: 0.9375rem; }
      .locale-gate__grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
      .locale-gate__btn { min-width: 150px; }
    </style>
  </body>
</html>
