---
import { languages } from '../i18n/ui';
import { getLangFromUrl, getRouteFromUrl, useTranslations } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const currentRoute = getRouteFromUrl(Astro.url).replace(/\/$/, '');

const langOptions = [
  { code: 'en', name: languages.en, initial: 'EN' },
  { code: 'es', name: languages.es, initial: 'ES' },
  { code: 'ru', name: languages.ru, initial: 'RU' },
  { code: 'pt', name: languages.pt, initial: 'PT' },
];

const currentLangData = langOptions.find((l) => l.code === currentLang) || langOptions[0];
---

<!--
  Lista corta de enlaces = navegación, no un menú de comandos: sin role="menu"/"menuitem".
  Popover nativo: Esc, clic fuera y retorno del foco los resuelve el navegador.
-->
<div class="language-selector" data-language-selector>
  <button
    class="language-trigger"
    type="button"
    aria-expanded="false"
    aria-label={t('a11y.changeLang')}
    aria-controls="language-menu"
    popovertarget="language-menu"
    popovertargetaction="toggle"
  >
    <span class="language-initial">{currentLangData.initial}</span>
    <svg class="language-chevron" aria-hidden="true" viewBox="0 0 24 24">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </button>
  <div class="language-dropdown" id="language-menu" popover="auto">
    {langOptions.map((option) => (
      <a
        class={`language-option ${option.code === currentLang ? 'language-option--active' : ''}`}
        href={`/${option.code}/${currentRoute ? currentRoute + '/' : ''}`}
        lang={option.code}
        aria-current={option.code === currentLang ? 'true' : undefined}
      >
        <span class="language-option-initial">{option.initial}</span>
        <span class="language-option-name">{option.name}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .language-selector {
    position: relative;
    z-index: 1000;
  }

  .language-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 15px;
    border: 2px solid var(--ink);
    background: var(--coral);
    color: var(--on-coral);
    box-shadow: 3px 3px 0 var(--ink);
    cursor: pointer;
    font: 800 0.625rem/1 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: transform 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
  }

  .language-trigger:hover {
    background: var(--blue-bright);
    color: var(--ink);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .language-trigger:active {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .language-trigger:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 3px;
  }

  .language-trigger[aria-expanded="true"] .language-chevron {
    transform: rotate(180deg);
  }

  .language-initial {
    font-size: 0.6875rem;
  }

  .language-chevron {
    width: 12px;
    height: 12px;
    fill: currentColor;
    transition: transform 140ms ease;
  }

  /* Popover (top layer): posición fija. Con anclaje CSS se pega al botón y se voltea si no cabe;
     sin él, el script de abajo coloca top/left al abrir. */
  .language-dropdown {
    position: fixed;
    inset: auto;
    top: 64px;
    right: 16px;
    min-width: 180px;
    margin: 0;
    padding: 8px;
    border: 2px solid var(--ink);
    background: var(--navy);
    color: inherit;
    box-shadow: 6px 6px 0 var(--ink);
    overflow: visible;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 140ms ease, transform 140ms ease, overlay 140ms allow-discrete, display 140ms allow-discrete;
  }

  .language-dropdown:popover-open {
    opacity: 1;
    transform: translateY(0);
  }

  /* Navegadores sin Popover API: el selector no se ofrece (se entra por /en/, /es/...). */
  @supports not selector(:popover-open) {
    .language-selector { display: none; }
  }

  @starting-style {
    .language-dropdown:popover-open {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @supports (position-area: block-end) {
    .language-dropdown {
      inset: auto;
      position-area: block-end span-inline-start;
      margin-block-start: 8px;
      position-try-fallbacks: flip-inline, flip-block;
    }
  }

  .language-option {
    display: grid;
    grid-template-columns: 32px 1fr;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 2px solid transparent;
    color: var(--white);
    text-decoration: none;
    transition: background-color 140ms ease, border-color 140ms ease;
  }

  .language-option:hover {
    border-color: var(--ink);
    background: var(--coral);
    color: var(--on-coral);
  }

  .language-option:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: -2px;
  }

  .language-option--active {
    border-color: var(--ink);
    background: rgba(255, 90, 60, 0.25);
  }

  .language-option-initial {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 2px solid var(--ink);
    background: var(--blue-bright);
    color: var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
    font: 700 0.6875rem/1 var(--font-mono);
    letter-spacing: .08em;
  }

  .language-option-name {
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>

<script>
  const selector = document.querySelector<HTMLElement>('[data-language-selector]');
  const trigger = selector?.querySelector<HTMLButtonElement>('.language-trigger');
  const dropdown = selector?.querySelector<HTMLElement>('.language-dropdown');

  if (selector && trigger && dropdown) {
    const hasAnchor = CSS.supports('position-area: block-end');

    // aria-expanded sigue al estado real del popover (abre/cierra por botón, Esc o clic fuera).
    dropdown.addEventListener('toggle', (event) => {
      const isOpen = (event as ToggleEvent).newState === 'open';
      trigger.setAttribute('aria-expanded', String(isOpen));
      if (isOpen && !hasAnchor) {
        // Respaldo sin anclaje CSS: borde derecho del popover alineado al del botón, dentro del viewport.
        const rect = trigger.getBoundingClientRect();
        const width = dropdown.offsetWidth;
        const left = Math.max(8, Math.min(rect.right - width, window.innerWidth - width - 8));
        dropdown.style.top = `${rect.bottom + 8}px`;
        dropdown.style.left = `${left}px`;
        dropdown.style.right = 'auto';
      }
    });
  }
</script>
