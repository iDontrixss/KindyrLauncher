---
import FeatureCard from './FeatureCard.astro';

const features = [
  {
    number: '01',
    label: 'INSTANCIAS',
    title: 'Cada partida, en su lugar.',
    description: 'Separá versiones, loaders y mods. Probá otra configuración sin tocar la partida que ya funciona.',
    view: 'instances',
    accent: 'blue',
  },
  {
    number: '02',
    label: 'MODRINTH',
    title: 'Encontrá tu próximo mod.',
    description: 'Explorá mods, modpacks y shaders desde Kindyr, con la versión y el loader de la instancia a la vista.',
    view: 'discover',
    accent: 'green',
  },
  {
    number: '03',
    label: 'IMPORTACIÓN .MRPACK',
    title: 'De paquete a partida.',
    description: 'Importá un modpack .mrpack y organizalo como una instancia lista para configurar.',
    view: 'import',
    accent: 'coral',
  },
  {
    number: '04',
    label: 'CUENTAS',
    title: 'Tus perfiles, a mano.',
    description: 'Tené tus cuentas Microsoft disponibles mientras preparás la próxima sesión.',
    view: 'accounts',
    accent: 'yellow',
  },
  {
    number: '05',
    label: 'MIGRAR LAUNCHER',
    title: 'Traé todo con vos.',
    description: 'Prism, CurseForge, Modrinth App, SKLauncher u oficial: elegí el origen e importá tus instancias.',
    view: 'migrate',
    accent: 'blue',
  },
  {
    number: '06',
    label: 'INSTALACIÓN OPTIMIZADA',
    title: 'Más FPS en un clic.',
    description: 'La tarjeta de Inicio instala el pack Keo Optimized y deja el juego fluido con estética vanilla.',
    view: 'home',
    accent: 'green',
  },
  {
    number: '07',
    label: 'SKINS',
    title: 'Cambiá de piel.',
    description: 'Buscá por usuario, guardá favoritas, subí la tuya y mirala en 3D antes de aplicar.',
    view: 'skins',
    accent: 'coral',
  },
  {
    number: '08',
    label: 'JAVA Y RENDIMIENTO',
    title: 'Sin pelearte con Java.',
    description: 'El launcher descarga el Java justo y verificado, y ajustás la RAM con sliders.',
    view: 'settings',
    accent: 'yellow',
  },
];
---

<section class="feature-carousel" id="funciones" aria-labelledby="feature-carousel-title" data-carousel>
  <div class="section-grid">
    <div class="section-kicker"><span>01</span> FUNCIONES DEL LAUNCHER</div>
    <h2 id="feature-carousel-title">TODO LISTO.<br /><em>MÁS JUEGO.</em></h2>
    <p class="yuyu-text">Ocho tarjetas que giran solas: lo que Kindyr hace por tus partidas.</p>
  </div>

  <div
    class="carousel-viewport"
    data-carousel-viewport
    aria-roledescription="carrusel"
    aria-label="Funciones del launcher"
  >
    <div class="carousel-track" data-carousel-track>
      {features.map((feature, index) => (
        <div class="carousel-slide" data-carousel-slide data-slide-title={feature.title} data-slide-index={String(index + 1)}>
          <FeatureCard {...feature} />
        </div>
      ))}
    </div>
    <button class="carousel-nav carousel-nav--prev" type="button" data-carousel-prev aria-label="Tarjeta anterior">
      <span aria-hidden="true">‹</span>
    </button>
    <button class="carousel-nav carousel-nav--next" type="button" data-carousel-next aria-label="Tarjeta siguiente">
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <div class="carousel-footer section-grid">
    <div class="carousel-dots" data-carousel-dots role="group" aria-label="Elegir tarjeta"></div>
    <p class="carousel-status" data-carousel-status role="status"></p>
  </div>
</section>

<style>
  .feature-carousel { padding: 130px 0 140px; overflow: clip; }
  .feature-carousel h2 { margin: 28px 0 0; font-size: clamp(43px, 4.8vw, 68px); font-weight: 700; line-height: .9; letter-spacing: -.055em; text-transform: uppercase; }
  .feature-carousel h2 em { color: var(--coral); font-style: normal; }
  .feature-carousel > div > p { max-width: 560px; margin: 22px 0 0; font-size: 21px; font-weight: 500; line-height: 1.6; }

  .carousel-viewport {
    position: relative;
    margin-top: 54px;
    overflow: hidden;
    touch-action: pan-y;
  }
  .carousel-track {
    position: relative;
    width: 100%;
    perspective: 1300px;
  }
  .carousel-slide {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(400px, 82vw);
    transition: transform 700ms cubic-bezier(.2, .75, .2, 1), opacity 700ms ease, visibility 700ms;
    will-change: transform;
  }
  .carousel-slide .feature-card { width: 100%; }

  .carousel-nav {
    position: absolute;
    top: 50%;
    z-index: 200;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 2px solid var(--ink);
    background: var(--coral);
    color: var(--white);
    box-shadow: 3px 3px 0 var(--ink);
    cursor: pointer;
    font-size: 30px;
    line-height: 1;
    transform: translateY(-50%);
    transition: transform 140ms ease, box-shadow 140ms ease;
  }
  .carousel-nav:hover { transform: translate(-2px, calc(-50% - 2px)); box-shadow: 5px 5px 0 var(--ink); }
  .carousel-nav:focus-visible { outline: 2px solid var(--white); outline-offset: 4px; }
  .carousel-nav--prev { left: max(18px, calc((100vw - var(--max)) / 2)); }
  .carousel-nav--next { right: max(18px, calc((100vw - var(--max)) / 2)); }
  .carousel-nav span { transform: translateY(-3px); }

  .carousel-footer { display: flex; align-items: center; gap: 18px; margin-top: 30px; }
  .carousel-dots { display: flex; flex-wrap: wrap; gap: 9px; }
  .carousel-dot {
    width: 13px;
    height: 13px;
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms ease;
  }
  .carousel-dot:hover { transform: scale(1.25); }
  .carousel-dot.active { background: var(--coral); }
  .carousel-dot:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }
  .carousel-status { margin: 0; color: var(--dim); font: 700 10px/1.5 var(--font-mono); letter-spacing: .06em; }

  @media (max-width: 680px) {
    .feature-carousel { padding: 100px 0; }
    .feature-carousel h2 { font-size: clamp(39px, 11vw, 55px); }
    .carousel-nav { width: 44px; height: 44px; font-size: 25px; }
    .carousel-nav--prev { left: 10px; }
    .carousel-nav--next { right: 10px; }
    .carousel-footer { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-viewport { overflow: visible; }
    .carousel-track { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 18px; height: auto !important; perspective: none; }
    .carousel-slide { position: static; width: auto; margin: 0; }
    .carousel-nav, .carousel-dots { display: none; }
  }
</style>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const track = root.querySelector('[data-carousel-track]');
    const viewport = root.querySelector('[data-carousel-viewport]');
    const slides = Array.from(track.querySelectorAll('[data-carousel-slide]'));
    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    const dotsWrap = root.querySelector('[data-carousel-dots]');
    const status = root.querySelector('[data-carousel-status]');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const total = slides.length;
    let active = 0;
    let timer = 0;
    let hovering = false;

    slides.forEach((slide, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'carousel-dot';
      dot.setAttribute('aria-label', 'Ir a la tarjeta ' + (index + 1) + ' de ' + total);
      dot.addEventListener('click', () => { goTo(index); restart(); });
      dotsWrap.appendChild(dot);
    });
    const dots = Array.from(dotsWrap.children);

    const offsetOf = (index) => {
      let offset = (index - active) % total;
      if (offset > total / 2) offset -= total;
      if (offset < -total / 2) offset += total;
      return offset;
    };

    const layout = () => {
      if (motionQuery.matches) return;
      const slideWidth = slides[0] ? slides[0].offsetWidth : 320;
      const step = slideWidth * 0.52 + Math.min(64, slideWidth * 0.16);
      let maxHeight = 0;
      slides.forEach((slide) => { maxHeight = Math.max(maxHeight, slide.offsetHeight); });
      track.style.height = maxHeight + 'px';
      slides.forEach((slide, index) => {
        if (index === 0) slide.style.marginLeft = (-slideWidth / 2) + 'px';
        const offset = offsetOf(index);
        const distance = Math.abs(offset);
        const x = offset * step;
        const z = -distance * 230;
        const rotate = offset === 0 ? 0 : (offset > 0 ? -1 : 1) * Math.min(50, 24 + distance * 9);
        slide.style.transform = 'translateX(' + x.toFixed(1) + 'px) translateZ(' + z + 'px) rotateY(' + rotate + 'deg)';
        slide.style.opacity = distance === 0 ? '1' : distance === 1 ? '0.9' : distance === 2 ? '0.55' : '0';
        slide.style.zIndex = String(100 - distance);
        slide.style.visibility = distance > 2 ? 'hidden' : 'visible';
        slide.style.pointerEvents = distance > 2 ? 'none' : '';
        const isActive = index === active;
        dots[index].classList.toggle('active', isActive);
        dots[index].setAttribute('aria-current', isActive ? 'true' : 'false');
      });
      const current = slides[active];
      if (status && current) {
        status.textContent = 'Tarjeta ' + (active + 1) + ' de ' + total + ' · ' + (current.dataset.slideTitle || '');
      }
    };

    const goTo = (index) => {
      active = ((index % total) + total) % total;
      layout();
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };

    const start = () => {
      stop();
      if (motionQuery.matches || hovering || document.hidden) return;
      timer = window.setInterval(() => goTo(active + 1), 4500);
    };

    const restart = () => start();

    prevBtn.addEventListener('click', () => { goTo(active - 1); restart(); });
    nextBtn.addEventListener('click', () => { goTo(active + 1); restart(); });

    viewport.addEventListener('pointerenter', () => { hovering = true; stop(); });
    viewport.addEventListener('pointerleave', () => { hovering = false; start(); });
    viewport.addEventListener('focusin', () => { hovering = true; stop(); });
    viewport.addEventListener('focusout', () => { hovering = false; start(); });
    document.addEventListener('visibilitychange', () => start());

    let dragStart = null;
    viewport.addEventListener('pointerdown', (event) => { dragStart = event.clientX; });
    viewport.addEventListener('pointerup', (event) => {
      if (dragStart === null) return;
      const delta = event.clientX - dragStart;
      dragStart = null;
      if (Math.abs(delta) < 50) return;
      goTo(active + (delta < 0 ? 1 : -1));
      restart();
    });
    viewport.addEventListener('pointercancel', () => { dragStart = null; });

    window.addEventListener('resize', () => layout(), { passive: true });
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => layout()).observe(viewport);
    }
    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) {
        stop();
        track.style.height = '';
        slides.forEach((slide) => {
          slide.style.transform = '';
          slide.style.opacity = '';
          slide.style.zIndex = '';
          slide.style.visibility = '';
          slide.style.pointerEvents = '';
          slide.style.marginLeft = '';
        });
      } else {
        layout();
        start();
      }
    });

    layout();
    start();
  });
</script>
