---
import FeatureCard from './FeatureCard.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    number: '01',
    label: t('feature.01.label'),
    title: t('feature.01.title'),
    description: t('feature.01.description'),
    view: 'instances',
    accent: 'blue',
  },
  {
    number: '02',
    label: t('feature.02.label'),
    title: t('feature.02.title'),
    description: t('feature.02.description'),
    view: 'discover',
    accent: 'green',
  },
  {
    number: '03',
    label: t('feature.03.label'),
    title: t('feature.03.title'),
    description: t('feature.03.description'),
    view: 'import',
    accent: 'coral',
  },
  {
    number: '04',
    label: t('feature.04.label'),
    title: t('feature.04.title'),
    description: t('feature.04.description'),
    view: 'accounts',
    accent: 'yellow',
  },
  {
    number: '05',
    label: t('feature.05.label'),
    title: t('feature.05.title'),
    description: t('feature.05.description'),
    view: 'migrate',
    accent: 'blue',
  },
  {
    number: '06',
    label: t('feature.06.label'),
    title: t('feature.06.title'),
    description: t('feature.06.description'),
    view: 'home',
    accent: 'green',
  },
  {
    number: '07',
    label: t('feature.07.label'),
    title: t('feature.07.title'),
    description: t('feature.07.description'),
    view: 'skins',
    accent: 'coral',
  },
  {
    number: '08',
    label: t('feature.08.label'),
    title: t('feature.08.title'),
    description: t('feature.08.description'),
    view: 'settings',
    accent: 'yellow',
  },
];
---

<section
  class="feature-carousel"
  id="funciones"
  aria-labelledby="feature-carousel-title"
  data-carousel
  data-label-card={t('carousel.card')}
  data-label-of={t('carousel.of')}
>
  <div class="section-grid">
    <div class="section-kicker"><span>01</span> {t('features.kicker')}</div>
    <h2 id="feature-carousel-title" set:html={t('features.subtitle')}></h2>
    <p class="yuyu-text">{t('features.description')}</p>
  </div>

  <div
    class="carousel-viewport"
    data-carousel-viewport
    aria-roledescription="carousel"
    aria-label={t('carousel.label')}
  >
    <div class="carousel-track" data-carousel-track>
      {features.map((feature, index) => (
        <div
          class="carousel-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${t('carousel.card')} ${index + 1} ${t('carousel.of')} ${features.length}`}
          data-carousel-slide
          data-slide-title={feature.title}
        >
          <FeatureCard {...feature} total={features.length} />
        </div>
      ))}
    </div>
    <button class="carousel-nav carousel-nav--prev" type="button" data-carousel-prev aria-label={t('carousel.prev')}>
      <span aria-hidden="true">‹</span>
    </button>
    <button class="carousel-nav carousel-nav--next" type="button" data-carousel-next aria-label={t('carousel.next')}>
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <div class="carousel-footer section-grid">
    <div class="carousel-dots" data-carousel-dots role="group" aria-label={t('carousel.select')}></div>
    <p class="carousel-status" data-carousel-status aria-live="off"></p>
  </div>
</section>

<style>
  .feature-carousel { padding: 130px 0 140px; overflow: clip; }
  .feature-carousel h2 { margin: 28px 0 0; font-size: clamp(2.6875rem, 4.8vw, 4.25rem); font-weight: 700; line-height: .9; letter-spacing: -.055em; text-transform: uppercase; }
  .feature-carousel h2 em { color: var(--coral); font-style: normal; }
  /* Antes era ".feature-carousel > div > p" y también atrapaba al texto de estado del footer. */
  .feature-carousel .section-grid > p.yuyu-text { max-width: 560px; margin: 22px 0 0; font-size: 1.3125rem; font-weight: 500; line-height: 1.6; }

  .carousel-viewport {
    position: relative;
    margin-top: 24px;
    /* aire arriba/abajo: la perspectiva agranda el borde cercano de las tarjetas laterales y las sombras duras (10px) se cortaban */
    padding: 56px 0 64px;
    overflow: hidden;
    touch-action: pan-y;
  }
  .carousel-track {
    position: relative;
    width: 100%;
    perspective: 1300px;
  }
  .carousel-slide {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(400px, 82vw);
    transition: transform 450ms cubic-bezier(.2, .75, .2, 1), opacity 450ms ease, visibility 450ms;
  }
  .carousel-slide .feature-card { width: 100%; }

  .carousel-nav {
    position: absolute;
    top: 50%;
    z-index: 200;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 2px solid var(--ink);
    background: var(--coral);
    color: var(--on-coral);
    box-shadow: 3px 3px 0 var(--ink);
    cursor: pointer;
    font-size: 1.875rem;
    line-height: 1;
    transform: translateY(-50%);
    transition: transform 140ms ease, box-shadow 140ms ease;
  }
  .carousel-nav:hover { transform: translate(-2px, calc(-50% - 2px)); box-shadow: 5px 5px 0 var(--ink); }
  .carousel-nav:focus-visible { outline: 2px solid var(--white); outline-offset: 4px; }
  .carousel-nav--prev { left: max(18px, calc((100% - var(--max)) / 2)); }
  .carousel-nav--next { right: max(18px, calc((100% - var(--max)) / 2)); }
  .carousel-nav span { transform: translateY(-3px); }

  /* El autoplay (>5 s) exige un control visible de pausa (WCAG 2.2.2): el footer se muestra.
     El estado queda solo para lectores de pantalla (oculto visualmente, nunca display:none). */
  .carousel-footer { position: relative; display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: 4px; }
  .carousel-dots { display: flex; flex-wrap: wrap; gap: 0; }
  /* botón de 24px (objetivo táctil mínimo) con el punto visual de 13px dibujado en ::before */
  :global(.carousel-dot) {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  :global(.carousel-dot)::before {
    width: 13px;
    height: 13px;
    border: 2px solid var(--blue-pale);
    border-radius: 50%;
    background: transparent;
    content: '';
    transition: background-color 160ms ease, transform 160ms ease;
  }
  :global(.carousel-dot):hover::before { transform: scale(1.25); }
  :global(.carousel-dot.active)::before { background: var(--coral); border-color: var(--white); transform: scale(1.3); }
  :global(.carousel-dot):focus-visible { outline: 2px solid var(--white); outline-offset: 0; }
  .carousel-status { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (max-width: 680px) {
    .feature-carousel { padding: 100px 0; }
    .feature-carousel h2 { font-size: clamp(2.4375rem, 11vw, 3.4375rem); }
    .carousel-viewport { padding: 40px 0 48px; }
    .carousel-nav { width: 44px; height: 44px; font-size: 1.5625rem; }
    .carousel-nav--prev { left: 10px; }
    .carousel-nav--next { right: 10px; }
    .carousel-footer { flex-wrap: wrap; gap: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-viewport { padding: 0; overflow: visible; }
    .carousel-track { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 18px; height: auto !important; perspective: none; }
    .carousel-slide { position: static; width: auto; margin: 0; }
    .carousel-nav, .carousel-footer { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const viewport = root.querySelector<HTMLElement>('[data-carousel-viewport]')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]')!;
    const dotsWrap = root.querySelector<HTMLElement>('[data-carousel-dots]')!;
    const status = root.querySelector<HTMLElement>('[data-carousel-status]');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const total = slides.length;
    const INTERVAL = 4500;
    const carouselLabels = {
      card: root.dataset.labelCard || 'Card',
      of: root.dataset.labelOf || '/',
    };

    let active = 0;
    let timer = 0;
    let hovered = false;
    let focused = false;
    let inView = true;
    let step = 0;

    slides.forEach((_, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'carousel-dot';
      dot.setAttribute('aria-label', `${carouselLabels.card} ${index + 1} ${carouselLabels.of} ${total}`);
      dot.addEventListener('click', () => userGo(index));
      dotsWrap.appendChild(dot);
    });
    const dots = Array.from(dotsWrap.children) as HTMLElement[];

    const offsetOf = (index: number) => {
      let offset = (index - active) % total;
      if (offset > total / 2) offset -= total;
      if (offset < -total / 2) offset += total;
      return offset;
    };

    // Medir es caro (fuerza reflow): solo al cambiar el tamaño o cargar fuentes, no en cada cambio de tarjeta.
    const measure = () => {
      if (motionQuery.matches) return;
      const slideWidth = slides[0].offsetWidth || 320;
      step = slideWidth * 0.52 + Math.min(64, slideWidth * 0.16);
      let maxHeight = 0;
      slides.forEach((slide) => { maxHeight = Math.max(maxHeight, slide.offsetHeight); });
      track.style.height = maxHeight + 'px';
    };

    // Colocar solo escribe estilos: sin lecturas del DOM.
    const place = () => {
      if (motionQuery.matches) return;
      slides.forEach((slide, index) => {
        const offset = offsetOf(index);
        const distance = Math.abs(offset);
        const x = offset * step;
        const z = -distance * 230;
        const rotate = offset === 0 ? 0 : (offset > 0 ? -1 : 1) * Math.min(35, 24 + distance * 9);
        // left:50% + translateX(-50%) centra TODAS las slides (antes solo la primera tenía margin-left).
        slide.style.transform = `translateX(-50%) translateX(${x.toFixed(1)}px) translateZ(${z}px) rotateY(${rotate}deg)`;
        // Se ven la activa y 4 tarjetas más (2 a cada lado).
        slide.style.opacity = distance === 0 ? '1' : distance === 1 ? '0.9' : distance === 2 ? '0.5' : '0';
        slide.style.zIndex = String(100 - distance);
        slide.style.visibility = distance > 2 ? 'hidden' : 'visible';
        slide.style.pointerEvents = distance > 2 ? 'none' : '';
        slide.setAttribute('aria-hidden', distance === 0 ? 'false' : 'true');
        const isActive = index === active;
        dots[index].classList.toggle('active', isActive);
        dots[index].setAttribute('aria-current', isActive ? 'true' : 'false');
      });
      if (status) {
        status.textContent = `${carouselLabels.card} ${active + 1} ${carouselLabels.of} ${total} · ${slides[active].dataset.slideTitle || ''}`;
      }
    };

    const layout = () => { measure(); place(); };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };

    const start = () => {
      stop();
      if (motionQuery.matches || hovered || focused || !inView || document.hidden) return;
      timer = window.setInterval(() => goTo(active + 1), INTERVAL);
    };

    const goTo = (index: number) => {
      active = ((index % total) + total) % total;
      place();
    };

    // Navegación del usuario: los lectores de pantalla pasan a recibir el aviso; el autoplay no se pisa.
    const userGo = (index: number) => {
      status?.setAttribute('aria-live', 'polite');
      goTo(index);
      start();
    };

    prevBtn.addEventListener('click', () => userGo(active - 1));
    nextBtn.addEventListener('click', () => userGo(active + 1));

    // Hover y foco son dos fuentes distintas: cada una con su bandera.
    viewport.addEventListener('pointerenter', () => { hovered = true; start(); });
    viewport.addEventListener('pointerleave', () => { hovered = false; start(); });
    viewport.addEventListener('focusin', () => { focused = true; start(); });
    viewport.addEventListener('focusout', () => { focused = false; start(); });
    document.addEventListener('visibilitychange', start);

    // No animar mientras el carrusel no se ve en pantalla.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        start();
      }, { threshold: 0.15 }).observe(root);
    }

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); userGo(active - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); userGo(active + 1); }
    });

    let dragStart: number | null = null;
    viewport.addEventListener('pointerdown', (event) => {
      if ((event.target as HTMLElement).closest('button')) return;
      dragStart = event.clientX;
    });
    viewport.addEventListener('pointerup', (event) => {
      if (dragStart === null) return;
      const delta = event.clientX - dragStart;
      dragStart = null;
      if (Math.abs(delta) < 50) return;
      userGo(active + (delta < 0 ? 1 : -1));
    });
    viewport.addEventListener('pointercancel', () => { dragStart = null; });

    if ('ResizeObserver' in window) {
      // Observa viewport y slides: si cambia el texto o cargan las fuentes, se recalcula la altura.
      const ro = new ResizeObserver(() => layout());
      ro.observe(viewport);
      slides.forEach((slide) => ro.observe(slide));
    } else {
      window.addEventListener('resize', layout, { passive: true });
    }
    document.fonts?.ready.then(layout);

    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) {
        stop();
        track.style.height = '';
        slides.forEach((slide) => {
          slide.style.transform = '';
          slide.style.opacity = '';
          slide.style.zIndex = '';
          slide.style.visibility = '';
          slide.style.pointerEvents = '';
          slide.removeAttribute('aria-hidden');
        });
      } else {
        layout();
        start();
      }
    });

    layout();
    start();
  });
</script>
