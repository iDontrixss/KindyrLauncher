const columns = [
  {
    title: t('footer.colLauncher'),
    links: [
      { label: t('nav.download'), href: `/${lang}/descargar` },
      { label: t('nav.faq'), href: `/${lang}/#preguntas` },
      { label: 'GitHub', href: GITHUB_URL },
      { label: t('footer.releases'), href: RELEASES_URL },
    ],
  },
  {
    title: t('footer.colResources'),
    links: [
      { label: 'Modrinth', href: 'https://modrinth.com' },
      { label: 'Discord', href: 'https://discord.gg/ARt6jxm9q' },
      { label: 'Minecraft', href: 'https://www.minecraft.net' },
      { label: 'Mojang', href: 'https://www.mojang.com' },
    ],
  },
  {
    title: t('footer.colInfo'),
    links: [
      { label: t('footer.changelogs'), href: 'https://www.minecraft.net/en-us/articles' },
      { label: t('footer.contact'), href: 'mailto:Kindyrsupport@gmail.com' },
    ],
  },
