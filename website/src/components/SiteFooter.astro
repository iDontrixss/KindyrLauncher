---

<footer class="kindyr-footer">
  <div class="section-grid kindyr-footer__grid">
    <div class="kindyr-footer__brand">
      <a class="brand" href={`/${lang}/#inicio`} aria-label={t('a11y.brandHome')}>
        <img src="/kindyr-logo.png" alt="" width="46" height="46" loading="lazy" />
        <span class="brand-copy"><strong>KINDYR</strong><span>MINECRAFT LAUNCHER</span></span>
      </a>
      <div class="kindyr-footer__social">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer" aria-label={s.name} title={s.name}>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
      <p class="kindyr-footer__slogan">{t('footer.slogan')}</p>
    </div>
    {columns.map((col) => (
      <nav class="kindyr-footer__col" aria-label={col.title}>
        <strong>{col.title}</strong>
        {col.links.map((link) => (
          link.href.startsWith('http') || link.href.startsWith('mailto:') ? (
            <a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel="noreferrer">{link.label}</a>
          ) : (
            <a href={link.href}>{link.label}</a>
          )
        ))}
      </nav>
    ))}
  </div>
  <div class="section-grid kindyr-footer__bottom">
    <p>© {year} Kindyr. {t('footer.rights')}<br />{t('footer.legal')}</p>
    <div class="kindyr-footer__legal">
      <a href={privacyUrl} target="_blank" rel="noreferrer">{t('footer.privacy')}</a>
      <a href={termsUrl} target="_blank" rel="noreferrer">{t('footer.terms')}</a>
    </div>
  </div>
</footer>

<style>
  .kindyr-footer { border-top: 3px solid var(--ink); background: #02081a; }
  .kindyr-footer__grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 40px; padding-top: 64px; padding-bottom: 56px; }
  .kindyr-footer__brand { display: grid; align-content: start; gap: 20px; }
  .kindyr-footer__social { display: flex; flex-wrap: wrap; gap: 10px; }
  .kindyr-footer__social a { display: grid; place-items: center; width: 40px; height: 40px; border: 2px solid var(--ink); background: var(--surface-2); color: var(--muted); box-shadow: 3px 3px 0 var(--ink); transition: transform 120ms ease, background-color 120ms ease, color 120ms ease; }
  .kindyr-footer__social a:hover { background: var(--coral); color: var(--white); transform: translate(-2px, -2px); }
  .kindyr-footer__social svg { width: 19px; height: 19px; fill: currentColor; stroke: none; }
  .kindyr-footer__slogan { margin: 0; color: var(--dim); font-size: 13px; font-weight: 500; }
  .kindyr-footer__col { display: grid; align-content: start; gap: 14px; }
  .kindyr-footer__col strong { color: var(--white); font: 800 10px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .kindyr-footer__col a { width: fit-content; color: var(--muted); font-size: 14px; font-weight: 500; transition: color 120ms ease; }
  .kindyr-footer__col a:hover { color: var(--coral); }
  .kindyr-footer__bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; padding-bottom: 28px; border-top: 1px solid var(--line); }
  .kindyr-footer__bottom p { margin: 0; color: var(--dim); font-size: 12px; font-weight: 500; line-height: 1.7; }
  .kindyr-footer__legal { display: flex; flex-wrap: wrap; gap: 22px; }
  .kindyr-footer__legal a { color: var(--blue-pale); font: 800 9px/1 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .kindyr-footer__legal a:hover { color: var(--coral); }

  @media (max-width: 900px) {
    .kindyr-footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .kindyr-footer__grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
